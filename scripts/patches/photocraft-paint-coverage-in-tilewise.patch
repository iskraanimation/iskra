+            for tx in r.x0.div_euclid(COV_TILE)..=(r.x1 - 1).div_euclid(COV_TILE) {
+                let Some(t) = self.cov.tiles.get(&(tx, ty)) else { continue };
+                let dual = self.dual.as_ref().map(|d| d.tiles.get(&(tx, ty)));
+                let tr = Rect::new(tx * COV_TILE, ty * COV_TILE, (tx + 1) * COV_TILE, (ty + 1) * COV_TILE).intersect(&r);
+                for y in tr.y0..tr.y1 {
+                    for x in tr.x0..tr.x1 {
+                        let ti = ((y - ty * COV_TILE) * COV_TILE + (x - tx * COV_TILE)) as usize;
+                        let c = t.cov[ti];
+                        if c > 0.0 {
+                            let dv = dual.map(|d| d.map_or(0.0, |d| d.cov[ti]));
+                            out[(y - r.y0) as usize * w + (x - r.x0) as usize] = self.ctx.stroke_mask_wet(c, t.depth.get(ti).copied(), dv, x, y);
+                        }
+                    }
+                }
+            }
+        }
+        out
     }
 
